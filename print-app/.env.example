# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables, then redeploy.

# Backend API. Laptop: http://localhost:5000/api   Production: https://<your-railway-app>.up.railway.app/api
REACT_APP_API_BASE=http://localhost:5000/api

# Only used with an old backend. Login is now set per machine in the admin panel.
REACT_APP_REQUIRE_LOGIN=false
