# ─────────────────────────────────────────────────────────────────────
#  SnapPrints backend settings.
#  Laptop: copy this file to .env and fill in the DB_* lines — everything
#          else already works for local testing.
#  Railway: set these in the service's Variables tab (see DEPLOY.md).
# ─────────────────────────────────────────────────────────────────────

PORT=5000
# Public URL of this API, ending in /api. Railway: https://<your-app>.up.railway.app/api
API_BASE_URL=http://localhost:5000/api

# Database (DB_* or Railway's MYSQL* variables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=snapprints
# DB_SSL=true      # leave unset: SSL is on for remote hosts and off for localhost

# Auth — any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ── Payments ──
# mock     = no Razorpay needed, the print page shows "Simulate payment" (laptop only)
# razorpay = real checkout. Use rzp_test_… keys to test without real money.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Settings → Webhooks (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# ── File storage ──
# local = files saved in backend/local-storage (laptop)
# r2    = Cloudflare R2 (production)
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=snapprints-uploads
R2_UPLOAD_URL_TTL_SECONDS=600
R2_DOWNLOAD_URL_TTL_SECONDS=600

# Uploaded files are deleted after this many minutes (unless still waiting to print)
UPLOAD_MAX_AGE_MINUTES=30
# Module 2: paid shop orders nobody printed within this time are refunded
SHOP_QUEUE_EXPIRY_MINUTES=120

# Word → PDF conversion uses LibreOffice. Windows example:
#   LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# LIBREOFFICE_PATH=soffice

# Default customer OTP login for machines set to "Default" in the dashboard
#   false = scan QR → upload → pay (no login)     true = mobile OTP first
REQUIRE_CUSTOMER_LOGIN=false

# Old Raspberry Pi registration by serial number (no setup code).
# Keep true until all your Pis register with setup codes.
ALLOW_LEGACY_PI_REGISTRATION=true

# Kiosk OTP lifetime after payment; unused → EXPIRED + automatic refund
# OTP_TTL_MINUTES=30
# Refuse payment while the machine is offline (default: on in production, off locally)
# REQUIRE_MACHINE_ONLINE=true
# How long customers can report a problem with a paid order
# ISSUE_REPORT_WINDOW_HOURS=48

# Extra browser origins allowed to call the API (comma-separated)
# CORS_ORIGINS=https://print.snapprints.in,https://dashboard.snapprints.in

# Demo request emails from the landing page (Resend)
RESEND_API_KEY=
TO_EMAIL=

# ── Encryption at rest (documents in storage, kiosk OTPs) ──
# 64 hex characters. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set it once and never change it while orders are waiting to print.
DATA_ENCRYPTION_KEY=

# Business time zone for office hours, SLA, invoice dates (India)
BUSINESS_TZ_OFFSET=+05:30

# SCAN orders: how long the customer can download the scanned PDF
SCAN_RESULT_TTL_MINUTES=60
# SLA: a machine not heard from for this long counts as down
DOWNTIME_OFFLINE_MINUTES=5

# ── DPDP Act: privacy notice shown before upload ──
# Bump the version whenever the notice text changes.
CONSENT_REQUIRED=true
CONSENT_NOTICE_VERSION=2026-10
GRIEVANCE_NAME=SnapPrints Privacy Desk
GRIEVANCE_EMAIL=privacy@snapprints.in
# Full privacy policy page (optional)
PRIVACY_POLICY_URL=

# ── GST invoices / receipts (the business that receives the money) ──
# Without SELLER_GSTIN, receipts and bills are issued without GST lines.
# Prices are GST-inclusive. Confirm the rate and SAC code with your CA.
SELLER_NAME=SnapPrints
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_STATE=Maharashtra
INVOICE_PREFIX=SP
INVOICE_GST_RATE=18
INVOICE_SAC=
INVOICE_DUE_DAYS=30
